RunService.Heartbeat:Connect(function(dt)
    if not coordsGui.Enabled then return end
    dotT = dotT + dt * 2.5
    local p = (math.sin(dotT) + 1) * 0.5
    gDot.BackgroundColor3 = Color3.fromRGB(math.floor(30 + p * 30), math.floor(180 + p * 45), math.floor(40 + p * 30))
    local c = LocalPlayer.Character
    local hrp = c and c:FindFirstChild("HumanoidRootPart")
    if hrp then
        local pos = hrp.Position
        coordLabels.X.Text = string.format("%.1f", pos.X)
        coordLabels.Y.Text = string.format("%.1f", pos.Y)
        coordLabels.Z.Text = string.format("%.1f", pos.Z)
    else
        coordLabels.X.Text = "0.0"
        coordLabels.Y.Text = "0.0"
        coordLabels.Z.Text = "0.0"
    end
end)

